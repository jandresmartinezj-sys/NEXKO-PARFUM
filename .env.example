# Copia este archivo a .env.local y rellena los valores reales.
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2024-10
# Credenciales OAuth de la app (opcional; no las usa el seed)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analítica (opcional — se cargan solo si tienen valor)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Revalidación on-demand (webhook de Shopify -> /api/revalidate?secret=...)
REVALIDATE_SECRET=

# Addi — widget de cuotas (opcional; se muestra solo si hay ally slug)
# Tu identificador de aliado, lo entrega Addi por correo (o activacion.aliados@addi.com)
NEXT_PUBLIC_ADDI_ALLY_SLUG=
# URL del script del widget (opcional; solo si Addi te dio una distinta a la estándar)
NEXT_PUBLIC_ADDI_WIDGET_SRC=
